<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101B27">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="@string/game_title"
                android:textColor="#212121"
                android:textSize="30sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/easy_button"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp"
                android:text="@string/easy_mode"
                android:textSize="18sp" />

            <Button
                android:id="@+id/normal_button"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp"
                android:text="@string/normal_mode"
                android:textSize="18sp" />

            <Button
                android:id="@+id/hard_button"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="@string/hard_mode"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/sound_switch"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/sound_enabled"
                android:textColor="#212121"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/selected_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityLiveRegion="polite"
                android:freezesText="true"
                android:gravity="center"
                android:text="@string/choose_mode"
                android:textColor="#555555"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
